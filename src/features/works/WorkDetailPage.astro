---
import type { AppWorkType } from '@shared/types';
import Image from 'astro/components/Image.astro';
import WorkDetailInfo from './components/WorkDetailInfo.astro';
import { MoveLeftIcon } from '@lucide/astro';

interface Props {
  work: AppWorkType;
}

const { work } = Astro.props;
---

<main class="py-12 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
    <!-- 戻るボタン -->
    <div class="px-2">
      <a
        href="/"
        class="inline-flex items-center text-sm text-muted-foreground hover:text-foreground transition-colors"
      >
        <MoveLeftIcon class="mr-2" size={12} />
        作品一覧に戻る
      </a>
    </div>

    <div
      class="grid grid-cols-1 lg:grid-cols-[400px_1fr] gap-12 items-start bg-primary-muted rounded-lg p-8"
    >
      <!-- 作品情報 -->
      <WorkDetailInfo work={work} />

      <!-- 画像 -->
      <div class="flex items-center justify-center">
        <Image
          src={work.imageUrl[0]}
          alt={work.title}
          width={work.width || 0}
          height={work.height || 0}
          class="w-auto h-auto object-contain rounded-sm"
          decoding="async"
        />
      </div>
    </div>
  </div>
</main>

<style scoped>
  .work-detail__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .work-detail__content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  img {
    --image_max_width: 100%;
    --image_max_height: 650px;

    width: auto;
    height: auto;
    max-width: var(--image_max_width);
    max-height: var(--image_max_height);
    box-shadow: 10px 16px 14px -7px rgba(0, 0, 128, 0.2);

    object-fit: contain;

    /* hover */
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  img:hover {
    transform: translateY(-4px);
    box-shadow: 12px 20px 18px -8px rgba(0, 0, 128, 0.3);
  }
</style>
