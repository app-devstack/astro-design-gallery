---
import { worksService } from '@/shared/service/worksService';
import WorkItem from '@/features/works/components/workItem.astro';

// 作品一覧取得
const works = await worksService.getWorks();
---

<main class="min-h-screen bg-background text-foreground">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- 作品一覧 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-16">
      {
        works.map((work, index) => (
          <div class="work-item opacity-0" data-index={index}>
            <WorkItem work={work} />
          </div>
        ))
      }
    </div>

    <!-- 作品数表示 -->
    {
      works.length > 0 && (
        <div class="mt-8 text-center text-sm text-gray-600">{works.length}件の作品を表示中</div>
      )
    }
  </div>
</main>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const items = document.querySelectorAll('.work-item');

  items.forEach((item) => {
    const index = parseInt(item.getAttribute('data-index') || '0');

    gsap.fromTo(
      item,
      { opacity: 0, y: 25 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        delay: (index % 4) * 0.1,
        ease: 'power2.out',
        scrollTrigger: { trigger: item, start: 'top 80%', once: true },
      }
    );
  });
</script>
