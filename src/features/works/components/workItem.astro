---
import type { AppWorkType } from '@/shared/types';
import Image from 'astro/components/Image.astro';

interface Props {
  work: AppWorkType;
}

const { work } = Astro.props;

// 画像は配列の最初のみを使用
const imageUrl = work.imageUrl[0] || '';

// 作品詳細ページのURL生成
const workUrl = `/works/${work.id}`;
---

<div class="flex flex-col gap-2">
   <!-- 画像 -->
  <div class="bg-muted p-8 rounded-sm">
    <a href={workUrl} class="block">
      <Image
        width={work.width || 304}
        height={work.height || 380}
        src={imageUrl}
        class="w-full h-auto aspect-[5/7] object-cover rounded-sm"
        alt={work.title}
        decoding="async"
      />
    </a>
  </div>


  <div class="flex flex-col gap-1 px-2">
    <!-- カテゴリ -->
    <!-- {
      category && (
        <p class="flex flex-wrap gap-1 m-0">
          <a href={`/category/${category.slug}`} class="no-underline">
            {category.name}
          </a>
        </p>
      )
    } -->

  <div class="space-y-1">
     <!-- タイトル -->
     <h3 class="font-medium text-sm text-foreground truncate">{work.title}</h3>

    <!-- タグ -->
    {
      work.tags?.length > 0 && (
        <p class="flex flex-wrap gap-2 text-[10px] tracking-wide text-muted-foreground">
          {work.tags.map((tag) => (
            <a
              href={`/tag/${tag.slug}`}
              class="before:content-['#'] hover:text-foreground transition-colors"
            >
              {tag.name}
            </a>
          ))}
        </p>
      )
    }
  </div>
</div>

<style scoped>
  img {
    --image_max_width: 100%;
    --image_max_height: 100%;
    flex: none;
    max-width: var(--image_max_width);
    max-height: var(--image_max_height);
    background: #fff;
    box-shadow: 10px 16px 14px -7px rgba(0, 0, 128, 0.2);

    /* hover */
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  img:hover {
    transform: translateY(-4px);
    box-shadow: 12px 20px 18px -8px rgba(0, 0, 128, 0.3);
  }
</style>
