---
import type { AppWorkType } from '@/shared/types';
import PolaroidCard from '@/shared/components/elements/PolaroidCard.astro';

interface Props {
  work: AppWorkType;
}

const { work } = Astro.props;

// 画像は配列の最初のみを使用
const imageUrl = work.imageUrl[0] || '';

// 作品詳細ページのURL生成
const workUrl = `/works/${work.id}`;
---

<div class="p-6 sm:p-8 rounded-sm h-full space-y-6 flex flex-col items-center">
  <PolaroidCard
    href={workUrl}
    src={imageUrl}
    alt={work.title}
    title={work.title}
    width={work.width || 400}
    height={work.height || 480}
  />

  <!-- タグ -->
  {
    work.tags?.length > 0 && (
      <p class="flex flex-wrap justify-center gap-2 text-[10px]" role="list" aria-label="タグ一覧">
        {work.tags.map((tag) => (
          <a
            href={`/works?tag=${tag.slug}`}
            class="text-muted-foreground/80 hover:text-foreground transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-sm px-1"
            role="listitem"
            aria-label={`${tag.name}でフィルター`}
          >
            #{tag.name}
          </a>
        ))}
      </p>
    )
  }
</div>
