---
import { Image } from 'astro:assets';

interface Props {
  href: string;
  src: string;
  alt: string;
  title: string;
  width?: number;
  height?: number;
  className?: string;
}

const { href, src, alt, title, width = 400, height = 480, className } = Astro.props;
---

<!-- ポラロイド風カード -->
<a
  href={href}
  class:list={[
    'polaroid-card block group bg-white p-4 pb-12 polaroid-shadow w-full max-w-100 transition-all duration-300 ease-in-out transform hover:-translate-y-1 rotate-0 hover:rotate-1',
    className,
  ]}
>
  <!-- 画像 -->
  <div class="relative aspect-5/6 bg-gray-100 overflow-hidden mb-4">
    <Image
      width={width}
      height={height}
      src={src}
      class="w-full h-full object-cover"
      alt={alt}
      decoding="async"
    />

    <!-- オーバレイ + キラッ -->
    <div
      class="absolute inset-0 overlay transition-colors duration-300 overflow-hidden pointer-events-none"
    >
      <div class="shine-effect"></div>
    </div>
  </div>

  <div class="px-2 text-center space-y-2">
    <!-- タイトル -->
    <h3 class="font-medium text-sm text-foreground truncate tracking-wider">
      {title}
    </h3>
  </div>
</a>

<style>
  .polaroid-card {
    /* デフォルトの影の色 (RGB) */
    --polaroid-shadow-rgb: 77, 65, 216;
    /* デフォルトのオーバーレイ色 */
    --polaroid-overlay-color: rgba(0, 0, 0, 0.02);

    /* シャインエフェクトの色 (RGB) */
    --polaroid-shine-rgb: 255, 255, 255;
    /* シャインエフェクトのグラデーション */
    --polaroid-shine-gradient: linear-gradient(
      to right,
      rgba(var(--polaroid-shine-rgb), 0) 0%,
      rgba(var(--polaroid-shine-rgb), 0.1) 50%,
      rgba(var(--polaroid-shine-rgb), 0) 100%
    );
  }

  .polaroid-shadow {
    box-shadow: 0 4px 12px rgba(var(--polaroid-shadow-rgb), 0.08);
  }
  .polaroid-shadow:hover {
    box-shadow: 0 12px 24px rgba(var(--polaroid-shadow-rgb), 0.12);
  }

  /* 画像オーバーレイ */
  .overlay {
    background-color: transparent;
  }

  /* 親のgroupクラスがhoverされた時のスタイル */
  :global(.group):hover .overlay {
    background-color: var(--polaroid-overlay-color);
  }

  .shine-effect {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: var(--polaroid-shine-gradient);
    transform: skewX(-25deg);
    z-index: 10;
  }

  :global(.group):hover .shine-effect {
    animation: shine 0.75s ease-in-out;
  }

  @keyframes shine {
    0% {
      left: -50%;
    }
    100% {
      left: 200%;
    }
  }
</style>
