---
// ThemeToggle.astro - ダークモード切り替えボタン
---

<button
  id="theme-toggle"
  type="button"
  aria-label="テーマ切り替え"
  class="rounded-lg p-2 hover:bg-muted transition-colors"
>
  <span id="theme-toggle-light-icon" class="hidden text-xl">🌙</span>
  <span id="theme-toggle-dark-icon" class="hidden text-xl">☀️</span>
</button>

<script>
  const themeToggleBtn = document.getElementById('theme-toggle');
  const lightIcon = document.getElementById('theme-toggle-light-icon');
  const darkIcon = document.getElementById('theme-toggle-dark-icon');

  const htmlElement = document.documentElement;
  const isDarkThemeEnabled = htmlElement.classList.contains('dark');

  // アイコン更新
  function updateIcon(isDark: boolean) {
    lightIcon?.classList.toggle('hidden', isDark);
    darkIcon?.classList.toggle('hidden', !isDark);
  }

  // 初期テーマ設定の適用
  updateIcon(isDarkThemeEnabled);

  themeToggleBtn?.addEventListener('click', () => {
    const isDark = htmlElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');

    updateIcon(isDark);
  });
</script>
