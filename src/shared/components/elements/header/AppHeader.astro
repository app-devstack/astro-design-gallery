---
import { Font } from 'astro:assets';
import ThemeToggle from '@shared/components/elements/ThemeToggle.astro';
import { cn } from '@/shared/lib/utils';
const TITLE = 'maru-maruuu | Studio';
---

<Font cssVariable="--font-montserrat-alternates" preload />

<!-- 通常ヘッダー -->
 <header id="app-header-top" class="font-montserrat-alternates bg-background border-b border-border">
  <div class="max-w-7xl mx-auto py-4 px-4 flex items-center justify-between">
    <h1 class="text-3xl font-semibold text-foreground">{TITLE}</h1>
    <ThemeToggle />
  </div>
</header>

<!-- スクロール用ヘッダー -->
<header
  id="app-header-scroll"
  class={cn(
    'font-montserrat-alternates',
    'fixed top-0 z-50 w-full pointer-events-none -translate-y-5 cursor-pointer',
    'bg-transparent opacity-0'
  )}
>
  <div
    id="header-content"
    class="max-w-7xl mx-auto py-4 px-4 flex items-center justify-between"
  >
    <h1 id="header-title" class="text-xl font-semibold tracking-wide text-foreground">{TITLE}</h1>
  </div>
</header>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { showScrollHeader, hideScrollHeader } from '@shared/components/elements/header/utils';

  // ScrollTriggerプラグインを登録
  gsap.registerPlugin(ScrollTrigger);

  const topHeader = document.getElementById('app-header-top');
  const scrollHeader = document.getElementById('app-header-scroll');

  if (!topHeader || !scrollHeader) {
    console.error('Header elements not found');
    throw new Error('Required header elements are missing');
  }

  // 通常ヘッダーが画面外に出たらスクロールヘッダーを表示
  ScrollTrigger.create({
    trigger: topHeader,
    start: 'bottom top', // 通常ヘッダーの下端が画面上端に達したら開始
    onEnter: () => showScrollHeader(scrollHeader),
    onLeaveBack: () => hideScrollHeader(scrollHeader),
  });

  // ヘッダークリックでトップへスクロール
  scrollHeader.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

<style>
  .font-montserrat-alternates {
    font-family: var(--font-montserrat-alternates);
  }
</style>
