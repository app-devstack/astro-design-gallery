---
import { Font } from 'astro:assets';
import ThemeToggle from '@shared/components/elements/ThemeToggle.astro';
const TITLE = 'maru-maruuu | Studio';
---

<Font cssVariable="--font-montserrat-alternates" preload />

<!-- 通常ヘッダー -->
<header id="app-header-top" class="font-montserrat-alternates bg-background shadow">
  <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    <h1 class="text-3xl font-bold text-foreground">{TITLE}</h1>
    <ThemeToggle />
  </div>
</header>

<!-- スクロール用ヘッダー -->
<header
  id="app-header-scroll"
  class="font-montserrat-alternates fixed top-0 z-50 bg-transparent opacity-0 pointer-events-none -translate-y-5"
>
  <div
    id="header-content"
    class="max-w-7xl mx-auto py-4 px-4 sm:px-6 lg:px-8 flex items-center justify-between"
  >
    <h1 id="header-title" class="text-2xl font-bold text-foreground">{TITLE}</h1>
    <ThemeToggle />
  </div>
</header>

<script>
  import { showScrollHeader, hideScrollHeader } from '@shared/components/elements/header/utils';

  const scrollHeader = document.getElementById('app-header-scroll');

  if (!scrollHeader) {
    console.error('Scroll header not found');
    throw new Error('Required scroll header is missing');
  }

  let isScrolled = false;

  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;

    if (scrollY > 0 && !isScrolled) {
      isScrolled = true;
      showScrollHeader(scrollHeader);
      return;
    }

    if (scrollY === 0 && isScrolled) {
      isScrolled = false;
      hideScrollHeader(scrollHeader);
    }
  });
</script>

<style>
  .font-montserrat-alternates {
    font-family: var(--font-montserrat-alternates);
  }
</style>
